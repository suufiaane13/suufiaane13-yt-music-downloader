{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-schema-generator/schemas/config.schema.json",
  "bundle": {
    "targets": ["nsis"],
    "resources": [
      "bin/yt-dlp.exe",
      "bin/ffmpeg.exe",
      "bin/ffprobe.exe",
      "bin/deno.exe"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "nsis-branding/installer.ico",
        "headerImage": "nsis-branding/header.bmp",
        "sidebarImage": "nsis-branding/sidebar.bmp",
        "compression": "lzma"
      }
    }
  }
}