{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "YT Music",
  "version": "2.0.1",
  "identifier": "com.ytmusic.downloader",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YT Music Downloader",
        "width": 900,
        "height": 680,
        "visible": true,
        "maximized": true,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https: asset: http://asset.localhost:*; img-src 'self' http://127.0.0.1:* https://*.ytimg.com https://i.ytimg.com data: blob: asset: http://asset.localhost:*; style-src 'self' 'unsafe-inline'; media-src 'self' file: https: blob: asset: http://asset.localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
